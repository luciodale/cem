---
export type Carousel = {
  src: string;
  alt: string;
  style?: string;
};

type Props = {
  carousel: Carousel[];
};

const { carousel } = Astro.props;
---

<style>
  .my-slider-progress {
    background: #ccc;
  }

  .my-slider-progress-bar {
    height: 6px;
    transition: width 400ms ease;
    width: 0;
  }
</style>

<div class="splide h-full">
  <div class="splide__track h-full">
    <div class="splide__list">
      {
        carousel.map(({ src, alt, style }) => (
          <div class="splide__slide relative flex h-full w-full place-content-center">
            <img
              src={src}
              alt={alt}
              loading="lazy"
              class={style ?? "absolute bottom-0 h-full w-full object-cover"}
            />
          </div>
        ))
      }
    </div>
  </div>
  <div class="my-slider-progress">
    <div class="my-slider-progress-bar bg-cem"></div>
  </div>
</div>

<script>
  import Splide from "@splidejs/splide";
  import "@splidejs/splide/css";

  const root = document.querySelector<HTMLElement>(".splide");

  if (root) {
    const splide = new Splide(root, {
      type: "fade",
      perPage: 1,
      focus: "center",
      autoWidth: true,
      pagination: false,
      rewind: true,
      rewindByDrag: true,
      autoplay: true,
      interval: 3000,
      throttle: 300,
    });

    const bar = root.querySelector<HTMLElement>(".my-slider-progress-bar");

    splide.on("mounted move", () => {
      if (!bar) return;
      const end = splide.Components.Controller.getEnd() + 1;
      const rate = Math.min((splide.index + 1) / end, 1);
      bar.style.width = `${100 * rate}%`;
    });

    splide.mount();
  }
</script>
