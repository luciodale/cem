---
import Card from "../components/Card.astro";
import { accrediaLink } from "../config/externalLinks";
import { certifications } from "../data/certifications";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Certificazioni"
  description="Accreditamento ACCREDIA n. 302, certificazioni vitivinicola e oleicola MASAF, analisi BIO e autocontrollo HACCP del laboratorio CEM."
>
  <main class="text-slate-600">
    <h1
      class="px-4 pt-10 text-center text-3xl font-bold uppercase tracking-wide"
    >
      Certificazioni
    </h1>
    <div class="flex justify-center">
      <div
        class="grid grid-cols-1 gap-10 px-10 py-10 lg:grid-cols-2 xl:grid-cols-3"
      >
        {
          certifications.map((certification) => (
            <Card
              title={certification.title}
              description={certification.description}
              link={certification.link}
              linkCaption={certification.linkCaption}
            />
          ))
        }
      </div>
    </div>
    <div
      class="mx-auto flex max-w-5xl flex-wrap justify-center items-center px-6 py-10 sm:px-0"
    >
      <img
        src="/images/ilac-logo.svg"
        alt="ILAC MRA, Accordo di Mutuo Riconoscimento"
        class="w-48 sm:mr-10 mb-4 flex-shrink-0"
      />
      <a
        class="w-1/5 min-w-48 sm:mr-10 mb-4 flex-shrink-0"
        href={accrediaLink}
        target="_blank"
      >
        <img
          src="/images/accredia-logo.svg"
          alt="Accredia Logo"
          class="w-full"
        />
      </a>

      <img
        src="/images/ministro-agricoltura-logo.svg"
        alt="Ministero dell'Agricoltura, della Sovranità Alimentare e delle Foreste"
        class="w-1/4 min-w-64 mb-4 flex-shrink-0"
      />
      <img
        src="/images/regione-abruzzo-logo.svg"
        alt="Regione Abruzzo"
        class="w-1/4 min-w-64 mb-4 flex-shrink-0"
      />
    </div>
  </main>
</Layout>
